    <string name="pref_key_framerate" translatable="false">pref_key_framerate</string>
    <integer name="pref_default_framerate" translatable="false">15</integer>
    <string-array name="pref_list_framerate_values" translatable="false">
        <item>10</item>
        <item>15</item>
        <item>24</item>
        <item>30</item>
        <item>60</item>
    </string-array>

