    <bool name="pref_default_reconnect" translatable="false">true</bool>

    <string name="pref_key_reconnect_delay" translatable="false">pref_key_reconnect_delay</string>
    <integer name="pref_default_reconnect_delay" translatable="false">5</integer>

    <string name="pref_key_boot" translatable="false">pref_key_start_on_boot</string>
